{
  "name": "base_caddy",
  "base_image": "harbor.windmaker.net/limani/base",
  "maintainer": {
    "name": "Álvaro",
    "surname": "Castellano Vela",
    "email": "alvaro@windmaker.net"
  },
  "required_repositories": {
    "name": "caddy",
    "apt_sources": {
      "types": [
        "deb"
      ],
      "uris": [
        "http://packages.windmaker.net/caddy"
      ],
      "suites": [
        "any"
      ],
      "components": [
        "main"
      ],
      "architectures": [
        "amd64"
      ],
      "gpg_keyring": "/etc/apt/keyrings/windmaker.gpg"
    },
    "gpg_keyring": {
      "name": "windmaker",
      "content": {
        "type": "url",
        "data": [
          "http://packages.windmaker.net/WINDMAKER-GPG-KEY.pub"
        ]
      }
    }
  },
  "packages": [
    {
      "name": "caddy",
      "version": "2.11.4"
    }
  ],
  "readme": {
    "description": "This image is based on [base image](/base) and comes with caddy installed.",
    "additional_features": [
      "Caady is a web server."
    ]
  }
}
