{
  "name": "base_valkey_server",
  "base_image": "harbor.windmaker.net/limani/base",
  "maintainer": {
    "name": "Álvaro",
    "surname": "Castellano Vela",
    "email": "alvaro@windmaker.net"
  },
  "required_repositories": {
    "name": "percona-valkey-91",
    "apt_sources": {
      "types": [
        "deb"
      ],
      "uris": [
        "http://packages.windmaker.net/percona-valkey"
      ],
      "suites": [
        "resolute"
      ],
      "components": [
        "main"
      ],
      "architectures": [
        "amd64"
      ],
      "gpg_keyring": "/etc/apt/keyrings/windmaker.gpg"
    },
    "gpg_keyring": {
      "name": "windmaker",
      "content": {
        "type": "url",
        "data": [
          "http://packages.windmaker.net/WINDMAKER-GPG-KEY.pub"
        ]
      }
    }
  },
  "packages": [
    {
      "name": "percona-valkey-server",
      "version": "1:9.1.2-1.resolute"
    }
  ],
  "exposed_ports": [
    6379
  ],
  "command": [
    "valkey-server",
    "--protected-mode",
    "no"
  ],
  "readme": {
    "description": "This image is based on [base image](/base) and comes with percona-valkey-server installed.",
    "additional_features": [
      "Exposes port 6379.",
      "Runs valkey-server with `--protected-mode no` by default."
    ]
  }
}
