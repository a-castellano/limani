{
  "name": "base_bash_utils",
  "base_image": "harbor.windmaker.net/limani/base",
  "maintainer": {
    "name": "Álvaro",
    "surname": "Castellano Vela",
    "email": "alvaro@windmaker.net"
  },
  "packages": [
    {
      "name": "sudo",
      "version": "1.9.17p2-1ubuntu3"
    },
    {
      "name": "ruby",
      "version": "1:3.3build1"
    },
    {
      "name": "shunit2",
      "version": "2.1.8-4build1"
    },
    {
      "name": "make",
      "version": "4.4.1-3"
    },
    {
      "name": "shfmt",
      "version": "3.12.0-1"
    },
    {
      "name": "shellcheck",
      "version": "0.11.0-2"
    },
    {
      "name": "ca-certificates",
      "version": "20260601~26.04.1"
    }
  ],
  "extra_commands": [
    "gem install bashcov --version 3.0.3",
    "adduser --disabled-password --gecos '' ventus",
    "adduser ventus sudo",
    "echo '%sudo ALL=(ALL) NOPASSWD:ALL' >> /etc/sudoers"
  ],
  "user": "ventus",
  "readme": {
    "description": "This image is based on [base image](/base) and comes with bash development utils installed.",
    "additional_features": [
      "Creates a non-root user 'ventus' with sudo privileges",
      "Runs as user 'ventus' by default"
    ]
  }
}
