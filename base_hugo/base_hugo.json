{
  "name": "base_hugo",
  "base_image": "harbor.windmaker.net/limani/base_golang_1_26",
  "maintainer": {
    "name": "Álvaro",
    "surname": "Castellano Vela",
    "email": "alvaro@windmaker.net"
  },
  "packages": [
    {
      "name": "rsync",
      "version": "3.4.1+ds1-7ubuntu0.3"
    },
    {
      "name": "hugo",
      "version": "0.164.0"
    },
    {
      "name": "ca-certificates",
      "version": "20260601~26.04.1"
    },
    {
      "name": "openssh-client",
      "version": "1:10.2p1-2ubuntu3.5"
    },
    {
      "name": "openssl",
      "version": "3.5.5-1ubuntu3.4"
    }
  ],
  "copy": [
    {
      "source": "base_hugo/dart-sass",
      "destination": "/tmp/dart-sass"
    }
  ],
  "extra_commands": [
    "mv /tmp/dart-sass /usr/local/lib/dart-sass",
    "chmod 755 /usr/local/lib/dart-sass/sass",
    "ln -s /usr/local/lib/dart-sass/sass /usr/local/bin/sass"
  ],
  "readme": {
    "description": "This image is based on [base_golang_1_26 image](/base_golang_1_26) and comes with Hugo installed.",
    "additional_features": [
      "Added ssh and rsync packages for deployment purposes.",
      "dart-sass is also installed, check CI config."
    ]
  }
}
