{
  "name": "base_nodejs_26",
  "base_image": "harbor.windmaker.net/limani/base",
  "maintainer": {
    "name": "Álvaro",
    "surname": "Castellano Vela",
    "email": "alvaro@windmaker.net"
  },
  "required_repositories": {
    "name": "nodejs",
    "apt_sources": {
      "types": ["deb"],
      "uris": ["http://packages.windmaker.net/nodejs"],
      "suites": ["any"],
      "components": ["main"],
      "architectures": ["amd64"],
      "gpg_keyring": "/etc/apt/keyrings/windmaker.gpg"
    },
    "gpg_keyring": {
      "name": "windmaker",
      "content": {
        "type": "url",
        "data": ["http://packages.windmaker.net/WINDMAKER-GPG-KEY.pub"]
      }
    }
  },
  "readme": {
    "description": "This image is based on Limani base image, and comes with nodejs 26 installed.",
    "additional_features": [
      "Adds repo `http://packages.windmaker.net/nodejs any main`"
    ]
  },
  "packages": [
    {
      "name": "nodejs",
      "version": "26.13.1-1nodesource1"
    }
  ]
}
