{
  "name": "base_percona_client",
  "base_image": "harbor.windmaker.net/limani/base",
  "maintainer": {
    "name": "Álvaro",
    "surname": "Castellano Vela",
    "email": "alvaro@windmaker.net"
  },
  "required_repositories": {
    "name": "percona-mysql",
    "apt_sources": {
      "types": [
        "deb"
      ],
      "uris": [
        "http://packages.windmaker.net/percona"
      ],
      "suites": [
        "resolute"
      ],
      "components": [
        "percona-mysql"
      ],
      "architectures": [
        "amd64"
      ],
      "gpg_keyring": "/etc/apt/keyrings/windmaker.gpg"
    },
    "gpg_keyring": {
      "name": "windmaker",
      "content": {
        "type": "url",
        "data": [
          "http://packages.windmaker.net/WINDMAKER-GPG-KEY.pub"
        ]
      }
    }
  },
  "packages": [
    {
      "name": "daedalus-project-mysql-utils",
      "version": "0.4-7"
    },
    {
      "name": "percona-server-client",
      "version": "8.4.10-10-1.resolute"
    }
  ],
  "readme": {
    "description": "This image is based on [base image](/base) and comes with percona-server-client installed.",
    "additional_features": [
      "**daedalus-project-mysql-utils** allows you to change mysql root password"
    ]
  }
}
