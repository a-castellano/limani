{
  "name": "base_docker",
  "base_image": "harbor.windmaker.net/limani/base",
  "maintainer": {
    "name": "Álvaro",
    "surname": "Castellano Vela",
    "email": "alvaro@windmaker.net"
  },
  "required_repositories": {
    "name": "docker",
    "apt_sources": {
      "types": [
        "deb"
      ],
      "uris": [
        "http://packages.windmaker.net/docker"
      ],
      "suites": [
        "resolute"
      ],
      "components": [
        "main"
      ],
      "architectures": [
        "amd64"
      ],
      "gpg_keyring": "/etc/apt/keyrings/windmaker.gpg"
    },
    "gpg_keyring": {
      "name": "windmaker",
      "content": {
        "type": "url",
        "data": [
          "http://packages.windmaker.net/WINDMAKER-GPG-KEY.pub"
        ]
      }
    }
  },
  "packages": [
    {
      "name": "containerd.io",
      "version": "2.3.4-1~ubuntu.26.04~resolute"
    },
    {
      "name": "docker-ce",
      "version": "5:29.7.2-1~ubuntu.26.04~resolute"
    },
    {
      "name": "git-crypt",
      "version": "0.8.0-1"
    },
    {
      "name": "docker-ce-cli",
      "version": "5:29.7.2-1~ubuntu.26.04~resolute"
    },
    {
      "name": "docker-build",
      "version": "0.4-1"
    }
  ],
  "readme": {
    "description": "This image is based on [base image](/base) and comes with docker and docker utils installed.",
    "additional_features": [
      "Useful for docker in docker scenarios."
    ]
  }
}
