{
  "name": "base",
  "base_image": "ubuntu:resolute",
  "maintainer": {
    "name": "Álvaro",
    "surname": "Castellano Vela",
    "email": "alvaro@windmaker.net"
  },
  "required_repositories": {
    "name": "windmaker",
    "apt_sources": {
      "types": [
        "deb"
      ],
      "uris": [
        "http://packages.windmaker.net"
      ],
      "suites": [
        "any",
        "resolute"
      ],
      "components": [
        "main"
      ],
      "architectures": [
        "amd64"
      ],
      "gpg_keyring": "/etc/apt/keyrings/windmaker.gpg"
    },
    "gpg_keyring": {
      "name": "windmaker",
      "content": {
        "type": "url",
        "data": [
          "http://packages.windmaker.net/WINDMAKER-GPG-KEY.pub"
        ]
      }
    }
  },
  "readme": {
    "description": "This image is based on Ubuntu resolute image, only Windmaker repos are added.",
    "additional_features": [
      "Adds repo `http://packages.windmaker.net/ any main`",
      "Adds repo `http://packages.windmaker.net/ resolute main`"
    ]
  },
  "packages": []
}
